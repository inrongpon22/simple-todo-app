{
  "name": "simple-todo-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace @simple-todo/app",
    "dev:server": "npm run dev --workspace @simple-todo/server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present"
  }
}
